<odoo>
    <record id="view_partner_form_customer_management" model="ir.ui.view">
        <field name="name">res.partner.form.customer.management</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Chăm sóc khách hàng" name="customer_care" groups="spa.group_customer_management_user">
                    <group>
                        <group>
                            <field name="customer_code"/>
                            <field name="customer_type"/>
                            <field name="loyalty_point" readonly="1"/>
                        </group>
                        <group>
                            <field name="care_note" placeholder="Lưu ý khi chăm sóc khách hàng..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nhu cầu chăm sóc">
                            <field name="care_need_ids" context="{'default_partner_id': id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="need_type"/>
                                    <field name="state"/>
                                    <field name="next_date"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Hồ sơ tình trạng da">
                            <field name="skin_profile_ids" context="{'default_partner_id': id}">
                                <list editable="bottom">
                                    <field name="date_recorded"/>
                                    <field name="skin_type"/>
                                    <field name="condition_note"/>
                                    <field name="product_caution"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Liệu trình">
                            <field name="treatment_ids" context="{'default_partner_id': id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lịch sử điểm">
                            <field name="loyalty_transaction_ids" context="{'default_partner_id': id}">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="transaction_type"/>
                                    <field name="points"/>
                                    <field name="state"/>
                                    <field name="applied_by"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
