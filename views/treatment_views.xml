<odoo>
    <record id="view_customer_treatment_tree" model="ir.ui.view">
        <field name="name">customer.treatment.tree</field><field name="model">customer.treatment</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-info="state == 'in_progress'">
                <field name="name"/><field name="partner_id"/><field name="start_date"/><field name="end_date"/><field name="user_id"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_customer_treatment_form" model="ir.ui.view">
        <field name="name">customer.treatment.form</field><field name="model">customer.treatment</field>
        <field name="arch" type="xml">
            <form><header><field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done,cancel"/></header>
                <sheet><group><group><field name="name"/><field name="partner_id"/><field name="user_id"/></group>
                <group><field name="start_date"/><field name="end_date"/></group></group>
                <group><field name="description"/><field name="note"/></group></sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="view_customer_treatment_search" model="ir.ui.view">
        <field name="name">customer.treatment.search</field><field name="model">customer.treatment</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="partner_id"/><field name="user_id"/>
                <filter name="active" string="Đang thực hiện" domain="[('state','=','in_progress')]"/>
                <group expand="0" string="Nhóm theo"><filter name="group_state" string="Trạng thái" context="{'group_by':'state'}"/><filter name="group_partner" string="Khách hàng" context="{'group_by':'partner_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_customer_treatment" model="ir.actions.act_window">
        <field name="name">Liệu trình khách hàng</field><field name="res_model">customer.treatment</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_customer_treatment_search"/>
    </record>
</odoo>
