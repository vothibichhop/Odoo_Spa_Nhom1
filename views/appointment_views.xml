<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_spa_appointment_tree" model="ir.ui.view">
        <field name="name">spa.appointment.tree</field>
        <field name="model">spa.appointment</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_id"/>
                <field name="service_id"/>
                <field name="appointment_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_spa_appointment_form" model="ir.ui.view">
        <field name="name">spa.appointment.form</field>
        <field name="model">spa.appointment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="customer_id"/>
                        <field name="service_id"/>
                        <field name="appointment_date"/>
                        <field name="start_time"/>
                        <field name="end_time"/>
                        <field name="status"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_spa_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">spa.appointment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
