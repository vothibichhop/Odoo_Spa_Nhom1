<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_spa_room_list" model="ir.ui.view">
        <field name="name">spa.room.list</field>
        <field name="model">spa.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_spa_room_form" model="ir.ui.view">
        <field name="name">spa.room.form</field>
        <field name="model">spa.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group string="Giường trong phòng">
                        <field name="bed_ids" nolabel="1">
                            <list create="0" edit="0" delete="0">
                                <field name="name"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_spa_room" model="ir.actions.act_window">
        <field name="name">Phòng Spa</field>
        <field name="res_model">spa.room</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
