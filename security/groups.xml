<odoo>
    <record id="group_spa_billing_user" model="res.groups">
        <field name="name">Spa Billing User</field>
        <field name="implied_ids"
               eval="[(4, ref('account.group_account_invoice')), (4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="group_customer_management_user" model="res.groups">
        <field name="name">Customer Management User</field>
        <field name="implied_ids" eval="[(4, ref('group_spa_billing_user'))]"/>
    </record>
    <record id="group_customer_management_manager" model="res.groups">
        <field name="name">Customer Management Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_customer_management_user'))]"/>
    </record>
</odoo>
