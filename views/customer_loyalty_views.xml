<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loyalty_card_form_spa" model="ir.ui.view">
        <field name="name">loyalty.card.form.spa</field>
        <field name="model">loyalty.card</field>
        <field name="inherit_id" ref="loyalty.loyalty_card_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='history_ids']/list/field[@name='description']"
                   position="after">
                <field name="customer_id" optional="hide"/>
                <field name="appointment_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
