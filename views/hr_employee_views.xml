<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_employee_form_spa" model="ir.ui.view">
        <field name="name">hr.employee.form.spa</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="spa_employee_information" string="Thông tin nhân sự">
                    <group>
                        <field name="employee_code"/>
                        <field name="start_work_date"/>
                        <field name="employment_status"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_employee_tree_spa" model="ir.ui.view">
        <field name="name">hr.employee.list.spa</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="before">
                <field name="employee_code" optional="show"/>
            </xpath>
            <xpath expr="//list/field[@name='department_id']" position="after">
                <field name="start_work_date" optional="hide"/>
                <field name="employment_status" widget="badge" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
