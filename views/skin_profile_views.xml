<odoo>
    <record id="view_customer_skin_profile_tree" model="ir.ui.view">
        <field name="name">customer.skin.profile.tree</field><field name="model">customer.skin.profile</field>
        <field name="arch" type="xml">
            <list><field name="date_recorded"/><field name="partner_id"/><field name="skin_type"/><field name="user_id"/></list>
        </field>
    </record>
    <record id="view_customer_skin_profile_form" model="ir.ui.view">
        <field name="name">customer.skin.profile.form</field><field name="model">customer.skin.profile</field>
        <field name="arch" type="xml">
            <form><sheet>
                <group><group><field name="partner_id"/><field name="date_recorded"/><field name="skin_type"/></group><group><field name="user_id"/></group></group>
                <group><field name="condition_note"/><field name="product_caution"/><field name="staff_note"/></group>
            </sheet></form>
        </field>
    </record>
    <record id="view_customer_skin_profile_search" model="ir.ui.view">
        <field name="name">customer.skin.profile.search</field><field name="model">customer.skin.profile</field>
        <field name="arch" type="xml">
            <search><field name="partner_id"/><field name="skin_type"/><field name="user_id"/>
                <group expand="0" string="Nhóm theo"><filter name="group_skin_type" string="Loại da" context="{'group_by':'skin_type'}"/><filter name="group_partner" string="Khách hàng" context="{'group_by':'partner_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_customer_skin_profile" model="ir.actions.act_window">
        <field name="name">Hồ sơ tình trạng da</field><field name="res_model">customer.skin.profile</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_customer_skin_profile_search"/>
    </record>
</odoo>
